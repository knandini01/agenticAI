# Google Gemini (Google AI Studio — free)
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant vector database
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=enterprise_docs

# Neo4j Knowledge Graph
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=hackathon123

# Application
DATABASE_URL=data/enterprise.db
EXPERIENCE_DB_URL=data/experience.db
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Safety thresholds (adjust if needed)
CONFIDENCE_APPROVE_THRESHOLD=0.80
CONFIDENCE_RECHECK_MIN=0.50
RISK_APPROVE_MAX=0.30
RISK_HUMAN_MIN=0.70

# MCP Server
MCP_SERVER_PORT=8001
